# Copy to .env and adjust MODEL_PATH for your machine. Everything else has
# a working default, so you only need to change a line if your layout differs.

MODEL_PATH=models/Phi-3-mini-4k-instruct-q4.gguf

GRAPH_PATH=data/graph/kg.pkl
VECTORSTORE_PATH=data/vectorstore
SESSION_DIR=data/sessions

N_CTX=4096
N_THREADS=4

# 0 = CPU only. Set to -1 to offload all layers to GPU during graph building,
# which needs a CUDA-enabled llama-cpp-python build.
N_GPU_LAYERS=0
